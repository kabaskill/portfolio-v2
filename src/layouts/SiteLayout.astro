---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Oguz Kabasakal | Developer and designer",
  description = "Developer building thoughtful web experiences across code, design, and sound.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <a
      class="fixed top-0 left-4 z-50 -translate-y-16 rounded-md bg-primary px-4 py-3 text-sm font-semibold text-white transition-transform focus:translate-y-4"
      href="#main-content">Skip to content</a
    >
    <header
      class="relative mx-auto flex min-h-18 w-[min(1400px,calc(100%-2rem))] items-center gap-3 border-b border-border max-[767px]:w-full max-[767px]:px-6"
    >
      <a class="mr-auto text-base font-semibold tracking-[-0.04em]" href="/">Oguz Kabasakal</a>
      <nav
        class="flex gap-5 text-sm text-muted-foreground max-[767px]:hidden"
        aria-label="Primary navigation"
      >
        <a
          class="transition-colors hover:text-primary"
          href="/work"
          aria-current={Astro.url.pathname.startsWith("/work") ? "page" : undefined}>Work</a
        >
        <a
          class="transition-colors hover:text-primary"
          href="/experiments"
          aria-current={Astro.url.pathname.startsWith("/experiments") ? "page" : undefined}
          >Experiments</a
        >
        <a
          class="transition-colors hover:text-primary"
          href="/journal"
          aria-current={Astro.url.pathname.startsWith("/journal") ? "page" : undefined}>Journal</a
        >
      </nav>
      <a
        class="inline-flex min-h-10 w-[7.6rem] items-center justify-between rounded-full bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground transition-transform hover:-translate-y-0.5"
        href="mailto:oguzkabasakal@gmail.com">Contact <span aria-hidden="true">↗</span></a
      >
      <button
        class="theme-toggle grid size-11 place-items-center rounded-full border border-border bg-transparent text-lg transition-colors hover:bg-muted"
        type="button"
        aria-label="Toggle color theme">☾</button
      >
      <button
        class="menu-toggle hidden size-11 place-items-center rounded-full border border-border bg-transparent text-lg max-[767px]:grid"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-navigation">☰</button
      >
      <nav
        id="mobile-navigation"
        class="absolute inset-x-0 top-full z-10 hidden gap-0 border-b border-border bg-background px-6 pb-4 max-[767px]:grid"
        aria-label="Mobile navigation"
        hidden
      >
        <a
          class="border-b border-border py-4 text-3xl font-semibold tracking-[-0.05em] transition-colors hover:text-primary"
          href="/work"
          aria-current={Astro.url.pathname.startsWith("/work") ? "page" : undefined}>Work ↗</a
        >
        <a
          class="border-b border-border py-4 text-3xl font-semibold tracking-[-0.05em] transition-colors hover:text-primary"
          href="/experiments"
          aria-current={Astro.url.pathname.startsWith("/experiments") ? "page" : undefined}
          >Experiments ↗</a
        >
        <a
          class="border-b border-border py-4 text-3xl font-semibold tracking-[-0.05em] transition-colors hover:text-primary"
          href="/journal"
          aria-current={Astro.url.pathname.startsWith("/journal") ? "page" : undefined}>Journal ↗</a
        >
        <a
          class="mt-4 border-0 py-4 text-3xl font-semibold tracking-[-0.05em] text-primary"
          href="mailto:oguzkabasakal@gmail.com">Contact ↗</a
        >
      </nav>
    </header>
    <main id="main-content" transition:animate="slide">
      <slot />
    </main>
    <footer
      class="mx-auto flex w-[min(1400px,calc(100%-2rem))] justify-between gap-8 border-t border-border py-8 text-sm text-muted-foreground max-[767px]:w-full max-[767px]:flex-col max-[767px]:gap-4 max-[767px]:px-6"
    >
      <span>© {new Date().getFullYear()} Oguz Kabasakal</span>
      <div class="flex gap-4">
        <a
          class="text-primary transition-colors hover:text-foreground"
          href="https://github.com/kabaskill"
          target="_blank"
          rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a
        >
        <a
          class="text-primary transition-colors hover:text-foreground"
          href="https://linkedin.com/in/oguzkabasakal"
          target="_blank"
          rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a
        >
      </div>
    </footer>
    <script is:inline>
      const initSite = () => {
        document.documentElement.classList.add("motion-ready");
        document.querySelectorAll("[data-reveal]").forEach((element) => {
          if (element.dataset.revealBound) return;
          element.dataset.revealBound = "true";
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            element.classList.add("is-visible");
            return;
          }
          const observer = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                element.classList.add("is-visible");
                observer.disconnect();
              }
            },
            { threshold: 0.08, rootMargin: "0px 0px -8%" },
          );
          observer.observe(element);
        });
        document.querySelectorAll("[data-magnetic]").forEach((element) => {
          if (element.dataset.magneticBound) return;
          element.dataset.magneticBound = "true";
          let frame = 0;
          let x = 0;
          let y = 0;
          const render = () => {
            frame = 0;
            element.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          };
          element.addEventListener("pointermove", (event) => {
            if (event.pointerType !== "mouse") return;
            const rect = element.getBoundingClientRect();
            x = (event.clientX - rect.left - rect.width / 2) * 0.12;
            y = (event.clientY - rect.top - rect.height / 2) * 0.16;
            if (!frame) frame = requestAnimationFrame(render);
          });
          element.addEventListener("pointerleave", () => {
            x = 0;
            y = 0;
            if (!frame) frame = requestAnimationFrame(render);
          });
        });
        const button = document.querySelector(".theme-toggle");
        const menuButton = document.querySelector(".menu-toggle");
        const mobileNavigation = document.querySelector("#mobile-navigation");
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || (!stored && matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
        if (button && !button.dataset.bound) {
          button.dataset.bound = "true";
          button.textContent = document.documentElement.classList.contains("dark") ? "☀" : "☾";
          button.addEventListener("click", () => {
            document.documentElement.classList.toggle("dark");
            localStorage.setItem(
              "theme",
              document.documentElement.classList.contains("dark") ? "dark" : "light",
            );
            button.textContent = document.documentElement.classList.contains("dark") ? "☀" : "☾";
          });
        }
        if (menuButton && mobileNavigation && !menuButton.dataset.bound) {
          menuButton.dataset.bound = "true";
          menuButton.addEventListener("click", () => {
            const open = mobileNavigation.hasAttribute("hidden");
            if (open) mobileNavigation.removeAttribute("hidden");
            else mobileNavigation.setAttribute("hidden", "");
            menuButton.setAttribute("aria-expanded", String(open));
            menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
            menuButton.textContent = open ? "×" : "☰";
          });
          mobileNavigation.querySelectorAll("a").forEach((link) =>
            link.addEventListener("click", () => {
              mobileNavigation.setAttribute("hidden", "");
              menuButton.setAttribute("aria-expanded", "false");
              menuButton.setAttribute("aria-label", "Open menu");
              menuButton.textContent = "☰";
            }),
          );
        }
      };
      initSite();
      document.addEventListener("astro:page-load", initSite);
    </script>
  </body>
</html>
