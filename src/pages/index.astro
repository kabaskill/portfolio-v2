---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import HeroSignal from "../components/HeroSignal.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getProjectImage } from "../lib/project-images";

const projects = (await getCollection("projects")).filter(({ data }) => data.published !== false);
const featured = projects.filter(({data}) => data.featured === true);
const experiment = projects.find(({ data }) => data.slug === "p5-js-experiments");
const experimentCover = experiment ? getProjectImage(experiment.data.cover) : null;
const gridSpans = [
  "md:col-span-7",
  "md:col-span-5 md:pt-20",
  "md:col-span-5",
  "md:col-span-7 md:pt-12",
];
const ctaClass = "group pointer-events-auto relative inline-flex min-h-14 items-center justify-between gap-5 rounded-full border py-[.65rem] pr-[.7rem] pl-[1.15rem] text-sm leading-normal font-semibold whitespace-nowrap focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-5 motion-safe:transition-transform motion-safe:duration-350 motion-safe:ease-spring motion-safe:hover:-translate-y-[3px] motion-safe:active:scale-[.97] md:gap-8 md:pl-6";
const arrowClass = "grid size-9 place-items-center rounded-full text-[1.2rem] motion-safe:transition-transform motion-safe:duration-350 motion-safe:ease-spring";
---

<SiteLayout>
  <section class="relative isolate mx-auto grid w-full items-center overflow-clip px-6 pt-11 pb-8 md:min-h-[600px] md:w-[min(1400px,calc(100%-2rem))] md:overflow-visible md:px-0 md:pt-16 md:pb-20 lg:min-h-[660px]" aria-labelledby="hero-heading">
    <div class="pointer-events-none relative z-1 w-full md:w-[68%]">
      <h1 id="hero-heading" class="pointer-events-auto w-fit font-[550]">
        <span class="flex w-fit text-[clamp(3.25rem,12.3vw,5.75rem)] leading-[1.12] tracking-[-.08em] perspective-[800px] md:text-[clamp(5rem,9.7vw,8.7rem)]">
          <span class="sr-only">Developer</span>
          {Array.from("Developer").map((letter, index) => (
            <span class="hero-letter inline-block origin-[50%_90%]" aria-hidden="true" style={`--letter-index: ${index}`}>{letter}</span>
          ))}
        </span>
        <span class="mt-[.15rem] block pb-[.15em] text-[clamp(2.1rem,8.2vw,3.8rem)] leading-[1.18] tracking-[-.07em] md:text-[clamp(2.25rem,5vw,4.5rem)] hero-enter" style="--hero-delay: 150ms">
          <span class="my-[.3em] block text-[.52em] tracking-[-.04em] md:mt-[.1em] md:mb-[.25em]">with a</span> <em class="hero-rule relative inline-block text-primary not-italic after:mt-[.1em] after:block after:h-[.055em] after:w-full after:origin-left after:bg-primary">designer's eye.</em>
        </span>
      </h1>
      <div class="mt-6 md:mt-8">
        <p class="pointer-events-auto max-w-md text-base leading-[1.7] text-pretty text-muted-foreground md:max-w-92 md:text-[1.0625rem] lg:max-w-104 hero-enter" style="--hero-delay: 230ms">
          ...and a pair of <span class="text-primary text-[1.25rem] font-bold">musician's ears.</span>
        </p>
        <div class="mt-6 flex flex-wrap gap-3 md:mt-7 hero-enter" style="--hero-delay: 310ms">
          <a class:list={[ctaClass, "border-transparent bg-primary text-primary-foreground"]} href="/work">
            View work <span class:list={[arrowClass, "bg-primary-foreground text-primary motion-safe:group-hover:rotate-45"]} aria-hidden="true">↗</span>
          </a>
          <a class:list={[ctaClass, "border-border bg-background text-foreground hover:border-foreground hover:bg-card"]} href="#about">
            About me <span class:list={[arrowClass, "motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:translate-y-0.5"]} aria-hidden="true">↘</span>
          </a>
        </div>
      </div>
    </div>
    <HeroSignal />
  </section>

  <section
    class="mx-auto w-[min(1400px,calc(100%-2rem))] border-t border-border py-16 md:py-28 max-[767px]:w-full max-[767px]:px-6 max-[767px]:py-10"
  >
    <div
      class="mb-8 flex items-center justify-between gap-8 max-[767px]:mb-5 max-[767px]:flex-col max-[767px]:items-start max-[767px]:gap-5"
      data-reveal
    >
      <div>
        <h2 class="text-[clamp(2.4rem,5vw,4.5rem)] leading-[1.08] tracking-[-.06em] text-balance font-[550]">
          Selected <span class="text-primary">work.</span>
        </h2>
      </div>
      <a
        class="inline-flex min-h-13 items-center justify-center gap-4 rounded-full border border-border bg-transparent px-6 py-3.5 text-sm font-semibold text-foreground transition duration-200 hover:border-foreground hover:bg-foreground hover:text-background"
        href="/work">All work <span aria-hidden="true">↗</span></a
      >
    </div>
    <p
      class="mb-12 max-w-[46rem] text-base leading-7 text-pretty text-muted-foreground"
      data-reveal
    >
      A focused set of projects across software, design, and sound, where implementation and
      creative direction belong to the same process.
    </p>
    <div class="grid grid-cols-1 gap-x-6 gap-y-14 md:grid-cols-12 md:gap-y-20">
      {
        featured.map((project, index) => (
          <ProjectCard project={project} layoutClass={gridSpans[index % gridSpans.length]} />
        ))
      }
    </div>
  </section>

  <section id="about" class="scroll-mt-24 rounded-[20px] bg-card md:mx-4 md:rounded-[32px]">
    <div
      class="mx-auto w-[min(1400px,calc(100%-2rem))] py-20 lg:py-28 max-[767px]:w-full max-[767px]:px-6 max-[767px]:py-20"
    >
      <h2
        class="max-w-4xl text-[clamp(2.4rem,5vw,4.5rem)] leading-[1.08] tracking-[-.06em] text-balance font-[550]"
        data-reveal
      >
        What's happening on<span class="text-primary"
          > both sides of the screen</span> is important.
      </h2>
      <div
        class="mt-10 grid gap-8 md:mt-16 md:grid-cols-[1.2fr_1fr] md:gap-x-20 md:gap-y-10 max-[767px]:grid-cols-1 max-[767px]:gap-8"
      >
        <article
          class="grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-2 border-t border-border pt-6 md:row-span-2 md:block md:pt-8"
          data-reveal
        >
          <svg
            class="mb-5 block row-span-2 size-11 text-primary md:mb-8 md:size-20"
            viewBox="0 0 256 256"
            aria-hidden="true"
            ><path d="M240,128l-48,40H64L16,128,64,88H192Z" opacity=".2" fill="currentColor"
            ></path><path
              d="M69.12,94.15,28.5,128l40.62,33.85a8,8,0,1,1-10.24,12.29l-48-40a8,8,0,0,1,0-12.29l48-40a8,8,0,0,1,10.24,12.3Zm176,27.7-48-40a8,8,0,1,0-10.24,12.3L227.5,128l-40.62,33.85a8,8,0,1,0,10.24,12.29l48-40a8,8,0,0,0,0-12.29ZM162.73,32.48a8,8,0,0,0-10.25,4.79l-64,176a8,8,0,0,0,4.79,10.26A8.14,8.14,0,0,0,96,224a8,8,0,0,0,7.52-5.27l64-176A8,8,0,0,0,162.73,32.48Z"
              fill="currentColor"></path></svg
          >
          <h3 class="text-[clamp(1.4rem,2.6vw,2.2rem)] font-[550] leading-tight tracking-[-.045em]">
            Engineering
          </h3><p class="max-w-md text-[.95rem] leading-7 text-muted-foreground">
            Most of my work is in React and TypeScript. I like clear data flow, boring state management, and APIs that stay in charge of the data.
          </p>
        </article>
        <article
          class="grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-2 border-t border-border pt-6"
          data-reveal
        >
          <svg class="row-span-2 size-11 text-primary" viewBox="0 0 256 256" aria-hidden="true"
            ><path
              d="M135.88,43.11l-25,143.14a35.71,35.71,0,0,1-41.34,29.2h0a36,36,0,0,1-28.95-41.71l25-143.13a8,8,0,0,1,9.19-6.49l54.67,9.73A8,8,0,0,1,135.88,43.11Z"
              opacity=".2"
              fill="currentColor"></path><path
              d="M88,180a12,12,0,1,1-12-12A12,12,0,0,1,88,180Zm152-23.81V208a16,16,0,0,1-16,16H76a46.36,46.36,0,0,1-7.94-.68,44,44,0,0,1-35.43-50.95l25-143.13a15.94,15.94,0,0,1,18.47-13L130.84,26a16,16,0,0,1,12.92,18.52l-12.08,69L199.49,89a16,16,0,0,1,20.45,9.52L239,150.69A18.35,18.35,0,0,1,240,156.19ZM103,184.87,128,41.74,73.46,32l-25,143.1A28,28,0,0,0,70.9,207.57,27.29,27.29,0,0,0,91.46,203,27.84,27.84,0,0,0,103,184.87ZM116.78,195,224,156.11,204.92,104,128.5,131.7l-9.78,55.92A44.63,44.63,0,0,1,116.78,195ZM224,173.12,127.74,208H224Z"
              fill="currentColor"></path></svg
          >
          <h3 class="text-[clamp(1.4rem,2.6vw,2.2rem)] font-[550] leading-tight tracking-[-.045em]">
            Visual design
          </h3><p class="max-w-md text-[.95rem] leading-7 text-muted-foreground">
            I design while I build. Layout, typography, motion, responsive behavior. I would rather fix those things in the browser than treat them as a separate handoff.
          </p>
        </article>
        <article
          class="grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-2 border-t border-border pt-6"
          data-reveal
        >
          <svg class="row-span-2 size-11 text-primary" viewBox="0 0 256 256" aria-hidden="true"
            ><path d="M80,88v80H32a8,8,0,0,1-8-8V96a8,8,0,0,1,8-8Z" opacity=".2" fill="currentColor"
            ></path><path
              d="M155.51,24.81a8,8,0,0,0-8.42.88L77.25,80H32A16,16,0,0,0,16,96v64a16,16,0,0,0,16,16H77.25l69.84,54.31A8,8,0,0,0,160,224V32A8,8,0,0,0,155.51,24.81ZM32,96H72v64H32ZM144,207.64,88,164.09V91.91l56-43.55Zm54-106.08a40,40,0,0,1,0,52.88,8,8,0,0,1-12-10.58,24,24,0,0,0,0-31.72,8,8,0,0,1,12-10.58ZM248,128a79.9,79.9,0,0,1-20.37,53.34,8,8,0,0,1-11.92-10.67,64,64,0,0,0,0-85.33,8,8,0,1,1,11.92-10.67A79.83,79.83,0,0,1,248,128Z"
              fill="currentColor"></path></svg
          >
          <h3 class="text-[clamp(1.4rem,2.6vw,2.2rem)] font-[550] leading-tight tracking-[-.045em]">
            Media
          </h3><p class="max-w-md text-[.95rem] leading-7 text-muted-foreground">
            I worked in media production for years before moving into web development. That background still shows up in how I think about timing, rhythm, transitions, and sound.
          </p>
        </article>
      </div>
    </div>
  </section>

  {
    experiment && (
      <a
        class="mx-auto grid w-[min(1400px,calc(100%-2rem))] items-center gap-10 py-16 md:grid-cols-[1fr_1.1fr] md:gap-16 md:py-32 max-[767px]:w-full max-[767px]:grid-cols-1 max-[767px]:gap-10 max-[767px]:px-6 max-[767px]:py-16"
        data-reveal
        href="/experiments"
      >
        <div>
          <h2 class="text-[clamp(2.4rem,5vw,4.5rem)] leading-[1.08] tracking-[-.06em] text-balance font-[550]">
            Ideas need room to <span class="text-primary">misbehave.</span>
          </h2>
          <p class="mt-5 max-w-[38rem] text-base leading-7 text-pretty text-muted-foreground">
            WebGL, unusual interfaces, and small technical detours. A space to try things out.
          </p>
          <span class="mt-7 inline-flex min-h-13 items-center justify-center gap-4 rounded-full bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground">
            View experiments <span aria-hidden="true">↗</span>
          </span>
        </div>
        {experimentCover && (
          <Picture
            class="aspect-[1.2] rounded-xl object-cover transition-transform duration-500 ease-out motion-safe:hover:rotate-0 md:rotate-3"
            src={experimentCover}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            alt={experiment.data.alt}
            loading="lazy"
            widths={[480, 640, 960, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
          />
        )}
      </a>
    )
  }
</SiteLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-letter {
      animation: hero-letter-in 1s var(--ease-spring) both;
      animation-delay: calc(70ms + var(--letter-index) * 45ms);
    }
    .hero-enter {
      animation: hero-enter 0.9s var(--ease-spring) both;
      animation-delay: calc(var(--hero-delay, 0ms) + 280ms);
    }
    .hero-rule::after {
      animation: hero-rule-in 1.1s var(--ease-spring) 700ms both;
    }
  }

  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-letter-in {
    from { opacity: 0; transform: translateY(65%) rotateX(-65deg) rotateZ(5deg); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hero-rule-in {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
</style>
