---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import {
  ArrowDownRightIcon,
  ArrowUpRightIcon,
  CodeIcon,
  PaletteIcon,
  SpeakerHighIcon,
} from "@phosphor-icons/react/dist/ssr";
import HeroSignal from "../components/HeroSignal.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { cn } from "../lib/cn";
import { sortProjects } from "../data/project-orders";

const projects = (await getCollection("projects")).filter(({ data }) => data.published !== false);
const featured = sortProjects(projects.filter(({data}) => data.featured === true), "featured")
const experiment = projects.find(({ data }) => data.slug === "p5-js-experiments");
const experimentCover = experiment?.data.cover;
---

<SiteLayout>
  <section class={cn(
    "relative isolate mx-auto grid w-full items-center overflow-clip px-6 pt-11 pb-8",
    "md:min-h-[600px] md:w-[min(1400px,calc(100%-2rem))] md:overflow-visible md:px-0 md:pt-16 md:pb-20",
    "lg:min-h-[660px]",
  )} aria-labelledby="hero-heading">
    <div class="pointer-events-none relative z-1 w-full md:w-[68%]">
      <h1 id="hero-heading" class="pointer-events-auto w-fit font-[550]">
        <span class={cn(
          "flex w-fit text-[clamp(3.25rem,12.3vw,5.75rem)] leading-[1.12] tracking-[-.08em]",
          "perspective-[800px] md:text-[clamp(5rem,9.7vw,8.7rem)]",
        )}>
          <span class="sr-only">Developer</span>
          {Array.from("Developer").map((letter, index) => (
            <span class="hero-letter inline-block origin-[50%_90%]" aria-hidden="true" style={`--letter-index: ${index}`}>{letter}</span>
          ))}
        </span>
        <span class={cn(
          "hero-enter mt-[.15rem] block pb-[.15em]",
          "text-[clamp(2.1rem,8.2vw,3.8rem)] leading-[1.18] tracking-[-.07em]",
          "md:text-[clamp(2.25rem,5vw,4.5rem)]",
        )} style="--hero-delay: 150ms">
          <span class="my-[.3em] block text-[.52em] tracking-[-.04em] md:mt-[.1em] md:mb-[.25em]">with a</span> <em class={cn(
            "hero-rule relative inline-block text-primary not-italic",
            "after:mt-[.1em] after:block after:h-[.055em] after:w-full after:origin-left after:bg-primary",
          )}>designer's eye.</em>
        </span>
      </h1>
      <div class="mt-6 md:mt-8">
        <p class={cn(
          "hero-enter pointer-events-auto max-w-md text-base leading-[1.7] text-pretty text-muted-foreground",
          "md:max-w-92 md:text-[1.0625rem] lg:max-w-104",
        )} style="--hero-delay: 230ms">
          ...and a pair of <span class="text-primary text-[1.25rem] font-bold">musician's ears.</span>
        </p>
        <div class="mt-6 flex flex-wrap gap-3 md:mt-7 hero-enter" style="--hero-delay: 310ms">
          <a class={cn(
            "group pointer-events-auto relative inline-flex min-h-14 items-center justify-between gap-5 rounded-full border border-transparent",
            "bg-primary py-[.65rem] pr-[.7rem] pl-[1.15rem] text-sm leading-normal font-semibold text-primary-foreground whitespace-nowrap",
            "focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-5",
            "motion-safe:transition-transform motion-safe:duration-350 motion-safe:ease-spring",
            "motion-safe:hover:-translate-y-[3px] motion-safe:active:scale-[.97] md:gap-8 md:pl-6",
          )} href="/work">
            View work <span class={cn(
              "grid size-9 place-items-center rounded-full bg-primary-foreground text-primary",
              "motion-safe:transition-transform motion-safe:duration-350 motion-safe:ease-spring motion-safe:group-hover:rotate-45",
            )} aria-hidden="true"><ArrowUpRightIcon size={18} weight="bold" /></span>
          </a>
          <a class={cn(
            "group pointer-events-auto relative inline-flex min-h-14 items-center justify-between gap-5 rounded-full border border-border",
            "bg-background py-[.65rem] pr-[.7rem] pl-[1.15rem] text-sm leading-normal font-semibold text-foreground whitespace-nowrap",
            "hover:border-foreground hover:bg-card focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-5",
            "motion-safe:transition-transform motion-safe:duration-350 motion-safe:ease-spring",
            "motion-safe:hover:-translate-y-[3px] motion-safe:active:scale-[.97] md:gap-8 md:pl-6",
          )} href="#about">
            About me <span class={cn(
              "grid size-9 place-items-center rounded-full",
              "motion-safe:transition-transform motion-safe:duration-350 motion-safe:ease-spring",
              "motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:translate-y-0.5",
            )} aria-hidden="true"><ArrowDownRightIcon size={18} weight="bold" /></span>
          </a>
        </div>
      </div>
    </div>
    <HeroSignal />
  </section>

  <section
    class={cn(
      "mx-auto w-[min(1400px,calc(100%-2rem))] border-t border-border py-16 md:py-28",
      "max-[767px]:w-full max-[767px]:px-6 max-[767px]:py-10",
    )}
  >
    <div
      class={cn(
        "mb-8 flex items-center justify-between gap-8",
        "max-[767px]:mb-5 max-[767px]:flex-col max-[767px]:items-start max-[767px]:gap-5",
      )}
      data-reveal
    >
      <div>
        <h2 class="text-[clamp(2.4rem,5vw,4.5rem)] leading-[1.08] tracking-[-.06em] text-balance font-[550]">
          Selected <span class="text-primary">work.</span>
        </h2>
      </div>
      <a
        class={cn(
          "inline-flex min-h-13 items-center justify-center gap-4 rounded-full border border-border",
          "bg-transparent px-6 py-3.5 text-sm font-semibold text-foreground",
          "transition duration-200 hover:border-foreground hover:bg-foreground hover:text-background",
        )}
        href="/work">All work <ArrowUpRightIcon size={18} weight="bold" aria-hidden="true" /></a
      >
    </div>
    <p
      class="mb-12 max-w-[46rem] text-base leading-7 text-pretty text-muted-foreground"
      data-reveal
    >
      A focused set of projects across software, design, and sound, where implementation and
      creative direction belong to the same process.
    </p>
    <div class="grid grid-cols-1 gap-x-6 gap-y-14 md:grid-cols-12 md:gap-y-20">
      {
        featured.map((project, index) => (
          <div class={cn(
            index % 4 === 0 && "md:col-span-7",
            index % 4 === 1 && "md:col-span-5 md:pt-20",
            index % 4 === 2 && "md:col-span-5",
            index % 4 === 3 && "md:col-span-7 md:pt-12",
          )}>
            <ProjectCard project={project} sizes={`(min-width: 1432px) ${index % 4 === 0 || index % 4 === 3 ? 807 : 569}px, (min-width: 768px) ${index % 4 === 0 || index % 4 === 3 ? 58 : 42}vw, calc(100vw - 48px)`} />
          </div>
        ))
      }
    </div>
  </section>

  <section id="about" class="scroll-mt-24 rounded-[20px] bg-card md:mx-4 md:rounded-[32px]">
    <div
      class={cn(
        "mx-auto w-[min(1400px,calc(100%-2rem))] py-20 lg:py-28",
        "max-[767px]:w-full max-[767px]:px-6 max-[767px]:py-20",
      )}
    >
      <h2
        class="max-w-4xl text-[clamp(2.4rem,5vw,4.5rem)] leading-[1.08] tracking-[-.06em] text-balance font-[550]"
        data-reveal
      >
        What's happening on<span class="text-primary"
          > both sides of the screen</span> is important.
      </h2>
      <div
        class={cn(
          "mt-10 grid gap-8 md:mt-16 md:grid-cols-[1.2fr_1fr] md:gap-x-20 md:gap-y-10",
          "max-[767px]:grid-cols-1 max-[767px]:gap-8",
        )}
      >
        <article
          class={cn(
            "grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-2 border-t border-border pt-6",
            "md:row-span-2 md:block md:pt-8",
          )}
          data-reveal
        >
          <CodeIcon className="mb-5 block row-span-2 size-11 text-primary md:mb-8 md:size-20" weight="duotone" aria-hidden="true" />
          <h3 class="text-[clamp(1.4rem,2.6vw,2.2rem)] font-[550] leading-tight tracking-[-.045em]">
            Engineering
          </h3><p class="max-w-md text-[.95rem] leading-7 text-muted-foreground">
            Most of my work is in React and TypeScript. I like clear data flow, boring state management, and APIs that stay in charge of the data.
          </p>
        </article>
        <article
          class={cn(
            "grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-2",
            "border-t border-border pt-6",
          )}
          data-reveal
        >
          <PaletteIcon className="row-span-2 size-11 text-primary" weight="duotone" aria-hidden="true" />
          <h3 class="text-[clamp(1.4rem,2.6vw,2.2rem)] font-[550] leading-tight tracking-[-.045em]">
            Visual design
          </h3><p class="max-w-md text-[.95rem] leading-7 text-muted-foreground">
            I design while I build. Layout, typography, motion, responsive behavior. I would rather fix those things in the browser than treat them as a separate handoff.
          </p>
        </article>
        <article
          class={cn(
            "grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-2",
            "border-t border-border pt-6",
          )}
          data-reveal
        >
          <SpeakerHighIcon className="row-span-2 size-11 text-primary" weight="duotone" aria-hidden="true" />
          <h3 class="text-[clamp(1.4rem,2.6vw,2.2rem)] font-[550] leading-tight tracking-[-.045em]">
            Media
          </h3><p class="max-w-md text-[.95rem] leading-7 text-muted-foreground">
            I worked in media production for years before moving into web development. That background still shows up in how I think about timing, rhythm, transitions, and sound.
          </p>
        </article>
      </div>
    </div>
  </section>

  {
    experiment && (
      <a
        class={cn(
          "mx-auto grid w-[min(1400px,calc(100%-2rem))] items-center gap-10 py-16",
          "md:grid-cols-[1fr_1.1fr] md:gap-16 md:py-32",
          "max-[767px]:w-full max-[767px]:grid-cols-1 max-[767px]:gap-10 max-[767px]:px-6 max-[767px]:py-16",
        )}
        data-reveal
        href="/experiments"
      >
        <div>
          <h2 class="text-[clamp(2.4rem,5vw,4.5rem)] leading-[1.08] tracking-[-.06em] text-balance font-[550]">
            Ideas need room to <span class="text-primary">misbehave.</span>
          </h2>
          <p class="mt-5 max-w-[38rem] text-base leading-7 text-pretty text-muted-foreground">
            WebGL, unusual interfaces, and small technical detours. A space to try things out.
          </p>
          <span class={cn(
            "mt-7 inline-flex min-h-13 items-center justify-center gap-4 rounded-full",
            "bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground",
          )}>
            View experiments <ArrowUpRightIcon size={18} weight="bold" aria-hidden="true" />
          </span>
        </div>
        {experimentCover && (
          <Image
            class={cn(
              "block aspect-[1.2] w-full rounded-xl object-cover transition-transform duration-500 ease-out",
              "motion-safe:hover:rotate-0 md:rotate-3",
            )}
            src={experimentCover}
            format="webp"
            quality={80}
            width={Math.min(experimentCover.width, 1200)}
            widths={[400, 800, 1200].filter((width) => width < Math.min(experimentCover.width, 1200)).concat(Math.min(experimentCover.width, 1200))}
            sizes="(min-width: 1432px) 700px, (min-width: 768px) 50vw, calc(100vw - 48px)"
            alt={experiment.data.alt}
            loading="lazy"
          />
        )}
      </a>
    )
  }
</SiteLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-letter {
      animation: hero-letter-in 1s var(--ease-spring) both;
      animation-delay: calc(70ms + var(--letter-index) * 45ms);
    }
    .hero-enter {
      animation: hero-enter 0.9s var(--ease-spring) both;
      animation-delay: calc(var(--hero-delay, 0ms) + 280ms);
    }
    .hero-rule::after {
      animation: hero-rule-in 1.1s var(--ease-spring) 700ms both;
    }
  }

  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-letter-in {
    from { opacity: 0; transform: translateY(65%) rotateX(-65deg) rotateZ(5deg); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hero-rule-in {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
</style>
