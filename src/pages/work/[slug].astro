---
import { getImage } from "astro:assets";
import { getCollection, render } from "astro:content";
import MediaCollection from "../../components/react/MediaCollection";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getProjectImage } from "../../lib/project-images";
import { getProjectCategoryLabel } from "../../lib/project-taxonomy";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter(({ data }) => data.published !== false && !data.experiment)
    .map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const coverImage = getProjectImage(project.data.cover);
const coverThumbnail = await getImage({
  src: coverImage,
  width: Math.min(1200, coverImage.width),
  format: "webp",
  quality: 78,
});
const coverFull = await getImage({
  src: coverImage,
  width: Math.min(2400, coverImage.width),
  format: "webp",
  quality: 84,
});
---

<SiteLayout title={`${project.data.title} | Oguz Kabasakal`} description={project.data.summary} image={coverFull.src} imageAlt={project.data.alt}>
  <article
    class="mx-auto w-[min(1400px,calc(100%-2rem))] py-8 pb-20 max-[767px]:w-full max-[767px]:px-6 md:py-12 lg:pb-28"
  >
    <a
      class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-4 py-2 text-sm text-foreground transition-colors hover:border-foreground hover:bg-foreground hover:text-background"
      href="/work"><span aria-hidden="true">←</span> <span>All work</span></a
    >
    <div
      class="mt-10 grid items-start gap-14 max-[767px]:gap-0 lg:mt-14 lg:grid-cols-[minmax(0,1.85fr)_minmax(19rem,1fr)] lg:gap-12 xl:gap-20"
    >
      <div class="min-w-0">
        <header>
          <p class="font-mono text-xs text-primary">
            {getProjectCategoryLabel(project.data.category)}
          </p>
          <h1
            class="mt-4 max-w-[13ch] text-[clamp(2.75rem,6.2vw,5.6rem)] font-[560] leading-[.96] tracking-[-.065em] text-balance"
          >
            {project.data.title}
          </h1>
          <p class="mt-7 max-w-[58ch] text-lg leading-8 text-pretty text-muted-foreground">
            {project.data.summary}
          </p>
        </header>
        <section class="mt-12 border-t border-border pt-3 lg:mt-16" aria-label="Project story">
          <p class="py-5 font-mono text-[.68rem] uppercase tracking-wider text-muted-foreground">
            About the work
          </p><div class="rich-text max-w-[68ch]"><Content /></div>
        </section>
      </div>
      <aside class="max-[767px]:mt-12 min-w-0 lg:sticky lg:top-28 lg:mt-0">
        <div transition:name={`project-${project.data.slug}`}>
          <MediaCollection
            client:load
            cover={{ src: coverFull.src, thumbnailSrc: coverThumbnail.src, alt: project.data.alt }}
            coverTitle={project.data.title}
            embeds={project.data.embeds}
            images={project.data.gallery}
          />
        </div>
        {
          (project.data.role || project.data.year || project.data.tags.length > 0) && (
            <dl class="mt-6 grid grid-cols-2 gap-6 border-t border-border pt-4 text-sm">
              {project.data.role && (
                <div class="min-w-0">
                  <dt class="font-mono text-[.62rem] uppercase tracking-[.12em] text-muted-foreground">
                    Role
                  </dt>
                  <dd class="mt-1">{project.data.role}</dd>
                </div>
              )}
              {project.data.tags.length > 0 && (
                <div class="min-w-0 text-right">
                  <dt class="font-mono text-[.62rem] uppercase tracking-[.12em] text-muted-foreground">
                    Tags
                  </dt>
                  <dd class="mt-1 text-muted-foreground">
                    <ul class="grid gap-[.15rem] m-0 list-none p-0">
                      {project.data.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
          )
        }
        {
          project.data.links.length > 0 && (
            <section class="mt-6 grid gap-2" aria-labelledby="project-links-title">
              <h2 id="project-links-title" class="mb-1 font-mono text-xs font-medium tracking-wide">
                Project links
              </h2>
              {project.data.links.map((link) => (
                <a
                  class="inline-flex min-h-12 items-center justify-between gap-3 rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg"
                  href={link.url}
                  target={link.url.startsWith("http") ? "_blank" : undefined}
                  rel={link.url.startsWith("http") ? "noreferrer" : undefined}
                >
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </section>
          )
        }
      </aside>
    </div>
  </article>
</SiteLayout>
