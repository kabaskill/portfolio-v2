---
import { optimizedImage } from "../lib/optimized-image";
import { getCollection } from "astro:content";
import SpatialGallery from "../components/react/SpatialGallery";
import SpatialLayout from "../layouts/SpatialLayout.astro";
import { sortProjects } from "../data/project-orders";
const galleryProjects = sortProjects(
  (await getCollection("projects")).filter(({ data }) => data.published),
  "spatial-all",
);
const projects = await Promise.all(galleryProjects.map(async ({ data }) => ({
  title: data.title,
  slug: data.slug,
  cover: (await optimizedImage(data.cover, 800)).src,
  summary: data.summary,
  categories: data.categories,
  link:
    data.links[0]?.url ??
    (data.categories.includes("experiment") ?
      `/experiments/${data.slug}`
    : `/work/${data.slug}`),
})));
---

<SpatialLayout>
  <SpatialGallery projects={projects} client:only="react">
    <main
      slot="fallback"
      class="spatial-boot"
      role="status"
      aria-label="Preparing 3D gallery"
      aria-busy="true"
    >
      <div class="grid w-full max-w-sm justify-items-center text-center">
        <span class="spatial-boot-orbit" aria-hidden="true"></span>
        <p class="mt-5 font-mono text-xs uppercase tracking-[.14em]">Setting things in motion</p>
        <div class="mt-4 h-1 w-full overflow-hidden rounded-full bg-card" aria-hidden="true">
          <div class="h-full w-1/2 animate-pulse rounded-full bg-primary"></div>
        </div>
        <a class="mt-6 text-sm text-muted-foreground underline underline-offset-4 hover:text-primary" href="/work/">
          Browse the project list instead
        </a>
      </div>
    </main>
  </SpatialGallery>
</SpatialLayout>

<style>
  .spatial-boot { display: grid; min-height: 100dvh; place-items: center; padding: 24px; background: var(--background); color: var(--accent); }
  .spatial-boot-orbit { width: 48px; height: 48px; border: 1px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: boot-orbit 1.8s linear infinite; }
  @keyframes boot-orbit { to { transform: rotate(360deg); } }
</style>
