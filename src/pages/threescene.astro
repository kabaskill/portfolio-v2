---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import SpatialGallery from "../components/react/SpatialGallery";
import SpatialLayout from "../layouts/SpatialLayout.astro";
import { getProjectImage } from "../lib/project-images";
import { getProjectPath } from "../lib/project-taxonomy";
import { sortProjects } from "../lib/project-order";
const galleryProjects = sortProjects(
  (await getCollection("projects")).filter(({ data }) => data.published !== false),
);
const projects = await Promise.all(
  galleryProjects.map(async ({ data }) => {
    const cover = getProjectImage(data.cover);
    const optimizedCover = await getImage({
      src: cover,
      width: Math.min(960, cover.width),
      format: "webp",
      quality: 76,
    });
    return {
      title: data.title,
      slug: data.slug,
      cover: optimizedCover.src,
      summary: data.summary,
      category: data.category,
      experiment: data.experiment,
      link: data.links[0]?.url ?? getProjectPath(data),
    };
  }),
);
---

<SpatialLayout>
  <SpatialGallery projects={projects} client:only="react">
    <main slot="fallback" class="mx-auto max-w-3xl px-6 py-12">
      <a href="/">← Portfolio</a>
      <h1 class="mt-8 text-3xl">3D portfolio gallery</h1>
      <p class="mt-4">The interactive gallery needs JavaScript and WebGL. You can also browse every project below.</p>
      <ul class="mt-6 grid gap-3">
        {galleryProjects.map(({ data }) => (
          <li><a class="text-primary underline" href={getProjectPath(data)}>{data.title}</a></li>
        ))}
      </ul>
    </main>
  </SpatialGallery>
</SpatialLayout>
