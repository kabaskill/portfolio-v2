<div
  class="relative aspect-square w-[min(78vw,19rem)] justify-self-center md:w-full md:max-w-[48rem] md:justify-self-end"
  data-lab-flask
  aria-hidden="true"
>
  <canvas class="block size-full"></canvas>
</div>

<script>
  const initLabFlasks = () => {
    document.querySelectorAll<HTMLElement>("[data-lab-flask]").forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = "true";

      const canvas = root.querySelector("canvas")!;
      const context = canvas.getContext("2d");
      if (!context) return;

      const controller = new AbortController();
      const { signal } = controller;
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
      const bubbles = [
        { x: .37, offset: .04, radius: .013, speed: .000045 },
        { x: .48, offset: .17, radius: .019, speed: .000036 },
        { x: .59, offset: .27, radius: .011, speed: .000052 },
        { x: .67, offset: .11, radius: .016, speed: .000041 },
        { x: .43, offset: .31, radius: .009, speed: .000057 },
      ];
      let width = 0;
      let height = 0;
      let frame = 0;
      let visible = false;
      let disposed = false;
      let accent = "";
      let background = "";
      let foreground = "";

      const palette = () => {
        const style = getComputedStyle(root);
        accent = style.getPropertyValue("--accent").trim();
        background = style.getPropertyValue("--background").trim();
        foreground = style.getPropertyValue("--foreground").trim();
      };

      const flaskPath = () => {
        context.beginPath();
        context.moveTo(width * .42, height * .13);
        context.lineTo(width * .42, height * .35);
        context.bezierCurveTo(width * .42, height * .41, width * .3, height * .48, width * .23, height * .65);
        context.bezierCurveTo(width * .13, height * .88, width * .27, height * .92, width * .5, height * .92);
        context.bezierCurveTo(width * .73, height * .92, width * .87, height * .88, width * .77, height * .65);
        context.bezierCurveTo(width * .7, height * .48, width * .58, height * .41, width * .58, height * .35);
        context.lineTo(width * .58, height * .13);
        context.closePath();
      };

      const draw = (time = 0) => {
        if (!width || !height) return;
        context.clearRect(0, 0, width, height);
        const motionTime = reducedMotion.matches ? 0 : time;
        const surface = .61;

        // Fine guide marks echo the measured waveform treatment on the home hero.
        context.save();
        context.strokeStyle = foreground;
        context.globalAlpha = .12;
        context.lineWidth = 1;
        context.beginPath();
        context.moveTo(width * .12, height * .92);
        context.lineTo(width * .88, height * .92);
        for (let index = 0; index <= 12; index++) {
          const x = width * (.12 + index * .76 / 12);
          context.moveTo(x, height * .92);
          context.lineTo(x, height * (index % 3 === 0 ? .895 : .905));
        }
        context.stroke();
        context.restore();

        context.save();
        flaskPath();
        context.clip();

        const liquid = context.createLinearGradient(0, height * surface, 0, height * .92);
        liquid.addColorStop(0, accent);
        liquid.addColorStop(1, accent);
        context.fillStyle = liquid;
        context.globalAlpha = .82;
        context.beginPath();
        context.moveTo(width * .16, height);
        context.lineTo(width * .16, height * surface);
        for (let step = 0; step <= 36; step++) {
          const x = .16 + step * .68 / 36;
          const wave = Math.sin(step * .48 + motionTime * .0021) * .009;
          context.lineTo(width * x, height * (surface + wave));
        }
        context.lineTo(width * .84, height);
        context.closePath();
        context.fill();

        bubbles.forEach((bubble, index) => {
          const travel = .29;
          const progress = (bubble.offset + motionTime * bubble.speed) % travel;
          const y = .87 - progress;
          const x = bubble.x + Math.sin(motionTime * .0015 + index * 1.8) * .012;
          context.beginPath();
          context.arc(width * x, height * y, width * bubble.radius, 0, Math.PI * 2);
          context.fillStyle = background;
          context.globalAlpha = .72;
          context.fill();
          context.strokeStyle = foreground;
          context.globalAlpha = .18;
          context.lineWidth = 1;
          context.stroke();
        });
        context.restore();

        // Glass body, neck, and rim stay crisp above the liquid.
        context.save();
        flaskPath();
        context.fillStyle = background;
        context.globalAlpha = .025;
        context.fill();
        context.strokeStyle = foreground;
        context.globalAlpha = .78;
        context.lineWidth = Math.max(1.5, width * .006);
        context.lineJoin = "round";
        context.stroke();

        context.beginPath();
        context.roundRect(width * .39, height * .09, width * .22, height * .07, width * .025);
        context.fillStyle = background;
        context.globalAlpha = .04;
        context.fill();
        context.strokeStyle = foreground;
        context.globalAlpha = .78;
        context.stroke();

        context.beginPath();
        context.moveTo(width * .46, height * .2);
        context.lineTo(width * .46, height * .36);
        context.bezierCurveTo(width * .46, height * .4, width * .37, height * .49, width * .31, height * .65);
        context.strokeStyle = background;
        context.globalAlpha = .3;
        context.lineWidth = Math.max(1, width * .009);
        context.stroke();
        context.restore();
      };

      const render = (time: number) => {
        frame = 0;
        if (disposed) return;
        draw(time);
        if (visible && !document.hidden && !reducedMotion.matches) {
          frame = requestAnimationFrame(render);
        }
      };

      const requestDraw = () => {
        if (!disposed && visible && !frame) frame = requestAnimationFrame(render);
      };

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        const pixelRatio = Math.min(devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        draw(performance.now());
      };

      const visibility = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) requestDraw();
        else if (frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      });
      const dimensions = new ResizeObserver(resize);
      const theme = new MutationObserver(() => {
        palette();
        draw(performance.now());
      });

      palette();
      dimensions.observe(canvas);
      visibility.observe(root);
      theme.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
      reducedMotion.addEventListener("change", requestDraw, { signal });
      document.addEventListener("visibilitychange", requestDraw, { signal });
      document.addEventListener("astro:before-swap", () => {
        disposed = true;
        controller.abort();
        cancelAnimationFrame(frame);
        visibility.disconnect();
        dimensions.disconnect();
        theme.disconnect();
        delete root.dataset.bound;
      }, { once: true, signal });
    });
  };

  initLabFlasks();
  document.addEventListener("astro:page-load", initLabFlasks);
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    canvas { animation: lab-flask-in 1.35s var(--ease-spring) 180ms both; }
  }

  @keyframes lab-flask-in {
    from { opacity: 0; transform: translateY(22px) rotate(3deg); }
    to { opacity: 1; transform: none; }
  }
</style>
