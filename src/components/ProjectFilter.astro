---
import ProjectCard from "./ProjectCard.astro";

interface Project {
  id: string;
  data: {
    title: string;
    summary: string;
    slug: string;
    cover: string;
    alt: string;
    disciplines: string[];
    year?: number;
  };
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const filters = [
  ["all", "All work"],
  ["development", "Development"],
  ["design", "Design"],
  ["sound", "Sound"],
  ["music", "Music"],
] as const;
const spans = [
  "md:col-span-7",
  "md:col-span-5 md:pt-20",
  "md:col-span-5",
  "md:col-span-7 md:pt-12",
];
---

<div data-project-filter>
  <div class="flex flex-wrap gap-2 border-t border-border pt-6" role="group" aria-label="Filter projects">
    {filters.map(([value, label], index) => (
      <button class="min-h-11 rounded-full px-3.5 py-2.5 text-sm text-muted-foreground transition duration-200 hover:bg-muted active:scale-95 aria-pressed:bg-primary aria-pressed:text-primary-foreground" type="button" data-filter={value} aria-pressed={index === 0}>{label}</button>
    ))}
  </div>
  <div class="grid grid-cols-1 gap-x-6 gap-y-14 md:grid-cols-12 md:gap-y-20">
    {projects.map((project, index) => (
      <div class:list={["project-filter__item reveal", spans[index % spans.length]]} data-reveal data-project-item data-project-index={index} data-disciplines={project.data.disciplines.join(",")}>
        <ProjectCard project={project} />
      </div>
    ))}
  </div>
  <div class="flex justify-center" data-load-more-wrap>
    <button class="mt-14 inline-flex min-h-13 items-center justify-center gap-4 rounded-full border border-border bg-transparent px-6 py-3.5 text-sm font-semibold text-foreground transition duration-200 hover:border-foreground hover:bg-foreground hover:text-background" type="button" data-load-more>Load more work</button>
  </div>
  <p class="border border-border p-8 text-muted-foreground" data-filter-empty hidden>No projects in this category yet.</p>
</div>

<script>
  const initProjectFilters = () => document.querySelectorAll<HTMLElement>("[data-project-filter]").forEach((root) => {
    if (root.dataset.enhanced) return;
    root.dataset.enhanced = "true";
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const items = [...root.querySelectorAll<HTMLElement>("[data-project-item]")];
    const empty = root.querySelector<HTMLElement>("[data-filter-empty]");
    const loadMoreWrap = root.querySelector<HTMLElement>("[data-load-more-wrap]");
    const loadMore = root.querySelector<HTMLButtonElement>("[data-load-more]");
    const pageSize = 10;
    let visibleCount = pageSize;

    const update = (filter: string) => {
      let visible = 0;
      let matching = 0;
      items.forEach((item) => {
        const disciplines = item.dataset.disciplines?.split(",") ?? [];
        const matches = filter === "all" || disciplines.includes(filter);
        if (matches) matching += 1;
        const shown = matches && visible < visibleCount;
        item.hidden = !shown;
        item.classList.toggle("is-filtered", !shown);
        if (matches) visible += 1;
      });
      if (empty) empty.hidden = matching !== 0;
      if (loadMoreWrap) loadMoreWrap.hidden = matching <= visibleCount;
    };

    update("all");

    loadMore?.addEventListener("click", () => {
      visibleCount += pageSize;
      const active = buttons.find((button) => button.getAttribute("aria-pressed") === "true");
      update(active?.dataset.filter ?? "all");
    });

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter ?? "all";
        visibleCount = pageSize;

        buttons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
        update(filter);
      });
    });
  });
  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>
