---
import ProjectCard from "./ProjectCard.astro";
import { cn } from "../lib/cn";
import type { CollectionEntry } from "astro:content";
import { sortProjects } from "../data/project-orders";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const filters = [
  { value: "all", label: "All work" },
  { value: "development-design", label: "Development & Design" },
  { value: "sound-music", label: "Sound & Music" },
];
const projectsByFilter = Object.fromEntries(
  filters.map(({ value }) => [
    value,
    sortProjects(projects, `work-${value}`).map(({ data }) => data.slug),
  ]),
);
const orderedProjects = sortProjects(projects, "work-all");
---

<div data-project-filter data-project-orders={JSON.stringify(projectsByFilter)}>
  <div
    class="flex flex-wrap gap-2 border-t border-border py-4"
    role="group"
    aria-label="Filter projects"
  >
    {
      filters.map(({ value, label }, index) => (
        <button
          class={cn(
            "min-h-11 rounded-full px-3.5 py-2.5 text-sm text-muted-foreground",
            "transition duration-200 hover:bg-card active:scale-95",
            "aria-pressed:bg-primary aria-pressed:text-primary-foreground",
          )}
          type="button"
          data-filter={value}
          aria-pressed={index === 0}
        >
          {label}
        </button>
      ))
    }
  </div>
  <div class="grid grid-cols-1 gap-x-6 gap-y-14 md:grid-cols-12 md:gap-y-20">
    {
      orderedProjects.map((project, index) => (
        <div
          class={cn(
            [0, 3, 4].includes(index % 6) ? "md:col-span-7" : "md:col-span-5",
            [1, 5].includes(index % 6) && "md:pt-20",
            index % 6 === 3 && "md:pt-12",
            "xl:col-span-4",
            index % 2 === 0 ? "xl:pt-0" : "xl:pt-12",
          )}
          data-reveal
          data-project-item
          data-project-index={index}
          data-project-slug={project.data.slug}
          data-categories={project.data.categories.join(" ")}
        >
          <ProjectCard project={project} sizes={`(min-width: 1840px) 544px, (min-width: 1280px) 30vw, (min-width: 768px) ${[0, 3, 4].includes(index % 6) ? 58 : 42}vw, calc(100vw - 48px)`} />
        </div>
      ))
    }
  </div>
  <div class="flex justify-center" data-load-more-wrap>
    <button
      class={cn(
        "mt-14 inline-flex min-h-13 items-center justify-center gap-4 rounded-full border border-border",
        "bg-transparent px-6 py-3.5 text-sm font-semibold text-foreground",
        "transition duration-200 hover:border-foreground hover:bg-foreground hover:text-background",
      )}
      type="button"
      data-load-more>Load more work</button
    >
  </div>
  <div class="h-px" data-load-sentinel aria-hidden="true"></div>
  <p class="sr-only" data-project-status aria-live="polite"></p>
  <p class="border border-border p-8 text-muted-foreground" data-filter-empty hidden>
    No projects in this category yet.
  </p>
</div>

<script>
  const initProjectFilters = () =>
    document.querySelectorAll<HTMLElement>("[data-project-filter]").forEach((root) => {
      if (root.dataset.enhanced) return;
      root.dataset.enhanced = "true";
      const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
      const items = [...root.querySelectorAll<HTMLElement>("[data-project-item]")];
      const grid = root.querySelector<HTMLElement>("[data-project-item]")?.parentElement;
      const projectsByFilter = JSON.parse(root.dataset.projectOrders ?? "{}") as Record<
        string,
        string[]
      >;
      const empty = root.querySelector<HTMLElement>("[data-filter-empty]");
      const loadMoreWrap = root.querySelector<HTMLElement>("[data-load-more-wrap]");
      const loadMore = root.querySelector<HTMLButtonElement>("[data-load-more]");
      const sentinel = root.querySelector<HTMLElement>("[data-load-sentinel]");
      const status = root.querySelector<HTMLElement>("[data-project-status]");
      const controller = new AbortController();
      const { signal } = controller;
      const columns = () =>
        matchMedia("(min-width: 1280px)").matches ? 3
        : matchMedia("(min-width: 768px)").matches ? 2
        : 1;
      const pageSize = () => columns() * (columns() === 1 ? 6 : 3);
      let visibleCount = pageSize();
      let currentFilter = "all";
      let matchingCount = 0;

      const applyOrder = (filter: string) => {
        const order = new Map(
          (projectsByFilter[filter] ?? []).map((slug, index) => [slug, index]),
        );
        items.sort(
          (a, b) =>
            (order.get(a.dataset.projectSlug ?? "") ?? 0) -
            (order.get(b.dataset.projectSlug ?? "") ?? 0),
        );
        items.forEach((item) => grid?.append(item));
      };

      const update = (filter: string) => {
        let visible = 0;
        let matching = 0;
        items.forEach((item) => {
          const categories = item.dataset.categories?.split(" ") ?? [];
          const matches = filter === "all" || categories.includes(filter);
          if (matches) matching += 1;
          const shown = matches && visible < visibleCount;
          item.hidden = !shown;
          if (matches) visible += 1;
        });
        currentFilter = filter;
        matchingCount = matching;
        if (empty) empty.hidden = matching !== 0;
        const shownCount = Math.min(visibleCount, matching);
        const hasMore = matching > shownCount;
        const endsWithFullRow = shownCount > 0 && shownCount % columns() === 0;
        if (loadMoreWrap) loadMoreWrap.hidden = !hasMore || !endsWithFullRow;
        if (status) status.textContent = `Showing ${shownCount} of ${matching} projects`;
      };

      update("all");

      const showNextPage = () => {
        if (visibleCount >= matchingCount) return;
        visibleCount += pageSize();
        update(currentFilter);
      };

      loadMore?.addEventListener("click", showNextPage, { signal });

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.dataset.filter ?? "all";
          visibleCount = pageSize();

          buttons.forEach((candidate) =>
            candidate.setAttribute("aria-pressed", String(candidate === button)),
          );
          applyOrder(filter);
          update(filter);
        }, { signal });
      });

      if (sentinel && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) showNextPage();
          },
          { rootMargin: "0px 0px 480px", threshold: 0 },
        );
        observer.observe(sentinel);
        signal.addEventListener("abort", () => observer.disconnect(), { once: true });
      }

      let resizeFrame = 0;
      window.addEventListener("resize", () => {
        if (resizeFrame) cancelAnimationFrame(resizeFrame);
        resizeFrame = requestAnimationFrame(() => {
          const nextColumns = columns();
          visibleCount = Math.max(pageSize(), Math.ceil(visibleCount / nextColumns) * nextColumns);
          update(currentFilter);
        });
      }, { signal });

      document.addEventListener("astro:before-swap", () => {
        controller.abort();
        delete root.dataset.enhanced;
      }, { once: true, signal });
    });
  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>
