---
import { getImage } from "astro:assets";
import portrait from "../assets/profile/oguz-kabasakal.png";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const { title, description, image, imageAlt = "Oguz Kabasakal", noindex = false } = Astro.props;
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, Astro.site);
const defaultImage = image ? undefined : await getImage({ src: portrait, width: 800, format: "png" });
const socialImage = new URL(image ?? defaultImage!.src, Astro.site);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<script is:inline>
  (() => {
    let preference = null;
    try { preference = localStorage.getItem("theme"); } catch { /* Use the system theme. */ }
    const dark = preference === "dark" ||
      (preference !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.toggle("dark", dark);
  })();
</script>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Oguz Kabasakal" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt} />
<title>{title}</title>
