---
import type { CollectionEntry } from "astro:content";
import { ArrowUpRightIcon } from "@phosphor-icons/react/dist/ssr";
import ProjectCategories from "./ProjectCategories.astro";
import { cn } from "../lib/cn";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const href =
  data.categories.includes("experiment") ? `/experiments/${data.slug}` : `/work/${data.slug}`;
---

<a class={cn("group block")} data-reveal href={href}>
  <div
    class="relative aspect-[4/3] overflow-hidden rounded-xl bg-card"
    transition:name={`project-${data.slug}`}
  >
    <img
      class={cn(
        "block size-full object-contain transition-transform duration-[600ms] ease-out",
        "motion-safe:group-hover:scale-[1.04]",
      )}
      src={data.cover.src}
      alt={data.alt}
      loading="lazy"
    />
  </div>
  <div class="flex gap-4 pt-4 sm:grid sm:grid-cols-[1fr_auto] sm:items-start">
    <div>
      <p class="mb-2 font-mono text-xs text-primary">
        <ProjectCategories categories={data.categories} />{data.year ? ` / ${data.year}` : ""}
      </p>
      <h3
        class={cn(
          "m-0 text-2xl font-semibold tracking-tight transition-colors duration-200",
          "group-hover:text-primary sm:text-3xl",
        )}
      >
        {data.title}
      </h3>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-pretty text-muted-foreground">
        {data.summary}
      </p>
    </div>
    <span
      class={cn(
        "mt-1 hidden size-11 place-items-center rounded-full border border-border text-foreground",
        "transition duration-300 ease-out sm:grid",
        "motion-safe:group-hover:rotate-45 motion-safe:group-hover:border-primary",
        "motion-safe:group-hover:bg-primary motion-safe:group-hover:text-primary-foreground",
      )}
      aria-hidden="true"><ArrowUpRightIcon size={20} weight="bold" /></span
    >
  </div>
</a>
