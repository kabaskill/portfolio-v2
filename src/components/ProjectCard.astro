---
import { Image } from "astro:assets";
import { getProjectImage } from "../lib/project-images";
import { getProjectCategoryLabel, getProjectPath } from "../lib/project-taxonomy";

interface Props {
  layoutClass?: string;
  project: {
    data: {
      title: string;
      summary: string;
      slug: string;
      cover: string;
      alt: string;
      category: "development-design" | "sound-music";
      experiment: boolean;
      year?: number;
    };
  };
}

const { project, layoutClass = "" } = Astro.props;
const { data } = project;
const cover = getProjectImage(data.cover);
const href = getProjectPath(data);
const label = `${data.experiment ? "Experiment · " : ""}${getProjectCategoryLabel(data.category)}`;
---

<a class:list={["group block", layoutClass]} data-reveal href={href}>
  <div
    class="relative aspect-[4/3] overflow-hidden rounded-xl bg-card"
    transition:name={`project-${data.slug}`}
  >
    <Image
      class="block size-full object-contain transition-transform duration-[600ms] ease-out motion-safe:group-hover:scale-[1.04]"
      src={cover}
      alt={data.alt}
      loading="lazy"
      widths={[320, 480, 640, 800, 1200]}
      sizes="(min-width: 768px) 60vw, 100vw"
    />
  </div>
  <div class="flex gap-4 pt-4 sm:grid sm:grid-cols-[1fr_auto] sm:items-start">
    <div>
      <p class="mb-2 font-mono text-xs text-primary">
        {label}{data.year ? ` / ${data.year}` : ""}
      </p>
      <h3
        class="m-0 text-2xl font-semibold tracking-tight transition-colors duration-200 group-hover:text-primary sm:text-3xl"
      >
        {data.title}
      </h3>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-pretty text-muted-foreground">
        {data.summary}
      </p>
    </div>
    <span
      class="mt-1 hidden size-11 place-items-center rounded-full border border-border text-foreground transition duration-300 ease-out sm:grid motion-safe:group-hover:rotate-45 motion-safe:group-hover:border-primary motion-safe:group-hover:bg-primary motion-safe:group-hover:text-primary-foreground"
      aria-hidden="true">↗</span
    >
  </div>
</a>
